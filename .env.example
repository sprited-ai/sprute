# copy to .env (read from package root or cwd; `sprute login` is the other path)
REPLICATE_API_TOKEN=   # default provider: google/nano-banana-pro, + toonout matting — https://replicate.com/account/api-tokens
GEMINI_API_KEY=        # optional: --provider gemini (Nano Banana Pro direct) — https://aistudio.google.com/apikey
NOVITA_API_KEY=        # optional: --provider novita-seedream / novita-qwen
